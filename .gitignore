config.toml
# Placement presets, beside config.toml. No password in them, but they
# are one person's arm and one person's controller, tuned by hand with
# a headset on: as personal as config.toml, and no more use to anybody
# else.
presets/
# The run log: every reading, and the patient id. Health data, so it
# stays out of git for the same reason config.toml does.
logs/
# Where the window was last left. Per machine, and rewritten on every move.
state.json
state.json.tmp
preview.png
# The working sheet from `tools/preview.py --debug`. Rendered when the
# face changes and looked at; the committed one is preview-states.png,
# which README.md shows.
preview-debug.png
__pycache__/
*.pyc
.claude/
# Left behind by `pip install -e .`
*.egg-info/
build/
dist/
